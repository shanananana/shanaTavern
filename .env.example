# OpenAI-compatible LLM API (LM Studio, Ollama, vLLM, etc.)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=your-model-name
LLM_API_KEY=lm-studio

# JWT secret — change before any public deployment
SECRET_KEY=change-me-in-production

# Server
HOST=127.0.0.1
PORT=8787
ALLOW_REGISTRATION=false

# First-run admin (only when database is empty)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme

# User who can add accounts from Settings page (when registration is closed)
ACCOUNT_MANAGER_USERNAME=admin

# Optional: start ngrok tunnel when using ./start-daemon.sh (default off)
# Requires ngrok CLI + account; run once: ngrok config add-authtoken <token>
# Do NOT put the authtoken in this file
ENABLE_NGROK=false

# Logging & reliability
LOG_LEVEL=INFO
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=120
LLM_STREAM_IDLE_TIMEOUT=90
BOOTSTRAP_CACHE_TTL=60
SHUTDOWN_GRACE_SECONDS=10
